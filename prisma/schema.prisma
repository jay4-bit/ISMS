generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
  
}

enum ShopType {
  PHARMACY
  GENERAL
  LIQUOR
  ELECTRONICS
  CLOTHING
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#6b7280")
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, shopId])
}

model Shop {
  id          String    @id @default(cuid())
  name        String
  shopType    ShopType
  phone       String?
  email       String?
  address     String?
  currency    String    @default("TZS")
  currencySymbol String @default("TSh")
  isActive    Boolean   @default(true)
  logo        String?
  deletionCode        String?
  deletionCodeExpires DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  users       User[]
  products    Product[]
  categories  Category[]
  suppliers   Supplier[]
  brands      Brand[]
  customers   Customer[]
  sales       Sale[]
  expenses    Expense[]
  returns     Return[]
  purchaseOrders PurchaseOrder[]
  stockCounts StockCount[]
  settings    ShopSettings?
  permissions Permission[]
  activities  Activity[]
  reminders   Reminder[]
  customRoles CustomRole[]

  @@unique([name, shopType])
}

model User {
  id           String   @id @default(cuid())
  email        String
  password     String
  name         String
  role         String   @default("CASHIER")
  isActive     Boolean  @default(true)
  emailVerified Boolean @default(false)
  emailVerificationCode String?
  resetPasswordCode String?
  resetPasswordCodeExpires DateTime?
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]

  @@unique([email, shopId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  profitMargin Float    @default(0)
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name, shopId])
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  contactPerson  String?
  notes          String?
  licenseNumber  String?
  isActive       Boolean  @default(true)
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       Product[]
  purchaseOrders PurchaseOrder[]
  
  @@unique([name, shopId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@unique([name, shopId])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  sku             String
  barcode         String?
  description     String?
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  purchaseCost    Float
  sellingPrice    Float
  wholesalePrice  Float?
  stockQuantity   Int      @default(0)
  lowStockThreshold Int    @default(10)
  reorderPoint    Int      @default(20)
  isFaulty        Boolean  @default(false)
  hasExpiry       Boolean  @default(false)
  expiryDate      DateTime?
  hasSerialNumber Boolean  @default(false)
  weight          Float?
  taxRate         Float    @default(0)
  location        String?
  imageUrl        String?
  variant         String?
  variantType     String?
  brand           String?
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        ProductVariant[]
  saleItems       SaleItem[]
  stockMovements  StockMovement[]
  returns         ReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  priceTags       PriceTag[]
  stockCounts    StockCountItem[]
  serialNumbers   SerialNumber[]
  
  pharmacyFields  PharmacyProduct?
  liquorFields    LiquorProduct?
  electronicsFields ElectronicsProduct?
  clothingFields  ClothingProduct?
  
  @@unique([sku, shopId])
}

model PharmacyProduct {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandName             String?
  genericName           String?
  batchNumber           String?
  manufacturingDate     DateTime?
  expiryDate            DateTime?
  dosage                String?
  composition           String?
  manufacturer          String?
  prescriptionRequired  Boolean  @default(false)
  requiresColdStorage   Boolean  @default(false)
  drugSchedule          String?
  sideEffects           String?
  contraindications     String?
  interactionWarnings   String?
  storageInstructions   String?
}

model LiquorProduct {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand                 String?
  size                  Float?
  volume                Float?
  liquorType            String?
  vintage               String?
  origin                String?
  alcoholPercentage     Float?
  requiresLiquorLicense Boolean  @default(false)
  ageStatement          String?
  notes                 String?
}

model ElectronicsProduct {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand                 String?
  model                 String?
  condition             String?
  imei                  String?   @unique
  serialNumber          String?
  color                 String?
  storage               String?
  warranty               String?
  voltage               String?
  wattage               Float?
  specifications        String?
  weight                Float?
  accessoryGroup       String?
}

model ClothingProduct {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size                  String?
  color                 String?
  material              String?
  brand                 String?
  season                String?
  gender                String?
  pattern               String?
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantValue  String
  sku           String   @unique
  barcode       String?
  stockQuantity Int      @default(0)
  sellingPrice  Float
  purchaseCost  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, variantValue])
}

model SerialNumber {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  serialNumber String
  isSold      Boolean  @default(false)
  saleId      String?
  createdAt   DateTime @default(now())
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  type       StockMovementType
  quantity   Int
  reference  String?
  reason     String?
  createdAt  DateTime @default(now())
  createdBy  String?
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN_RESELLABLE
  RETURN_FAULTY
  DAMAGE
  THEFT
  EXPIRED
  AUDIT
}

model Sale {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  subtotal      Float
  taxAmount     Float    @default(0)
  discount      Float    @default(0)
  total         Float
  paymentMethod PaymentMethod
  saleType      SaleType      @default(RETAIL)
  amountPaid    Float
  changeGiven   Float    @default(0)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  installmentCustomerId String?
  installmentCustomer Customer? @relation("InstallmentCustomer", fields: [installmentCustomerId], references: [id])
  customerName  String?
  customerPhone String?
  customerAddress String?
  isInstallment Boolean  @default(false)
  installmentTotal Float?
  installmentPaid Float?
  installmentDue Float?
  nextPaymentDate DateTime?
  saleStatus   SaleStatus @default(COMPLETE)
  isPaid       Boolean   @default(true)
  createdAt     DateTime @default(now())
  cashierId     String
  cashier       User     @relation(fields: [cashierId], references: [id])
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  installmentPayments InstallmentPayment[]

  items         SaleItem[]
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  CREDIT
}

enum SaleType {
  RETAIL
  WHOLESALE
}

enum SaleStatus {
  COMPLETE
  INSTALLMENT
  CANCELLED
}

model InstallmentPayment {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  amount        Float
  amountPaid    Float
  balance       Float
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  taxAmount   Float   @default(0)
  discount    Float   @default(0)
  total       Float
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  prescriptionNumber String?
  dateOfBirth DateTime?
  creditLimit Float    @default(0)
  creditBalance Float  @default(0)
  loyaltyPoints Int    @default(0)
  totalPurchases Float @default(0)
  isActive    Boolean  @default(true)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sales       Sale[]
  installmentSales Sale[] @relation("InstallmentCustomer")
  
  @@unique([phone, shopId])
}

model Return {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  reason        String
  refundMethod  String?
  totalRefund   Float    @default(0)
  createdAt     DateTime @default(now())
  processedBy   String
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items         ReturnItem[]
}

model ReturnItem {
  id              String           @id @default(cuid())
  returnId        String
  return          Return           @relation(fields: [returnId], references: [id])
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  quantity        Int
  reason          String
  status          ReturnStatus
  refundAmount    Float
  supplierId      String?
  supplierName    String?
  awardedType     AwardedType      @default(REFUND)
  awardedAmount   Float           @default(0)
  repairCost      Float           @default(0)
  replacementProductId       String?
  replacementProductName     String?
  replacementProductPrice     Float?
  originalProductValue        Float?
  priceDifference             Float     @default(0)
  differencePaidBy           String    @default("CLIENT")
  returnCost      Float           @default(0)
  replacementPaymentMethod   String?
  replacementPaidAmount      Float           @default(0)
  replacementDiscount        Float           @default(0)
  replacementIsInstallment   Boolean         @default(false)
  replacementInstallmentTotal Float?
  replacementInstallmentPaid  Float?
  replacementInstallmentCustomerName String?
  replacementInstallmentCustomerPhone String?
  replacementRefundGiven       Float           @default(0)
  notes           String?
  createdAt       DateTime         @default(now())

  returnInstallmentPayments ReturnInstallmentPayment[]
}

model ReturnInstallmentPayment {
  id            String   @id @default(cuid())
  returnItemId  String
  returnItem    ReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  amount        Float    // total installment amount at time of payment
  amountPaid    Float    // this payment amount
  balance       Float    // remaining balance after this payment
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

enum AwardedType {
  REFUND
  REPLACEMENT
  REPAIR
  STORE_CREDIT
}

enum ReturnStatus {
  PENDING
  RESELLABLE
  FAULTY
  REFUNDED
  DISCARDED
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(PENDING)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  notes           String?
  expectedDelivery DateTime?
  receivedAt      DateTime?
  createdAt       DateTime @default(now())
  createdBy       String
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items           PurchaseOrderItem[]
}

enum PurchaseOrderStatus {
  PENDING
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  quantityOrdered Int
  quantityReceived Int    @default(0)
  unitCost        Float
  totalCost       Float
  productName     String?
  productSku      String?
  productBarcode  String?
  sellingPrice    Float?
  wholesalePrice  Float?
  electronicsBrand     String?
  electronicsModel     String?
  electronicsImei      String?
  electronicsColor     String?
  electronicsStorage   String?
  electronicsCondition String?
  pharmacyBrandName       String?
  pharmacyGenericName     String?
  pharmacyBatchNumber     String?
  pharmacyManufacturingDate DateTime?
  pharmacyExpiryDate      DateTime?
  pharmacyCategoryName    String?
  clothingBrand           String?
  clothingVariants        String?
  clothingCategoryName    String?
}

model PriceTag {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  barcode      String
  printedAt   DateTime @default(now())
  printedBy   String?
}

model StockCount {
  id          String   @id @default(cuid())
  countNumber String   @unique
  status      StockCountStatus @default(IN_PROGRESS)
  notes       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdBy   String
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items       StockCountItem[]
}

enum StockCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model StockCountItem {
  id          String   @id @default(cuid())
  stockCountId String
  stockCount  StockCount @relation(fields: [stockCountId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  systemQty   Int
  countedQty  Int?
  variance    Int?
  notes       String?
}

model Expense {
  id          String   @id @default(cuid())
  category    ExpenseCategory
  amount      Float
  description String
  reference   String?
  date        DateTime @default(now())
  createdBy   String
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  TRANSPORT
  MEDICAL_WASTE
  SECURITY
  INSURANCE
  OTHER
}

model ShopSettings {
  id              String   @id @default(cuid())
  shopId          String   @unique
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  businessName    String   @default("My Shop")
  businessPhone   String?
  businessEmail   String?
  businessAddress String?
  currency        String   @default("TZS")
  currencySymbol  String   @default("TSh")
  taxRate         Float    @default(0)
  receiptFooter   String?
  lowStockAlert   Boolean  @default(true)
  expiryAlert     Boolean  @default(true)
  expiryAlertDays Int      @default(7)
  pharmacyLicense String?
  liquorLicense   String?
  pharmacyName    String?
  pharmacistName  String?
  pharmacistLicense String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Permission {
  id        String   @id @default(cuid())
  role      String
  module    String
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  canDelete Boolean  @default(false)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module, shopId])
}

model Reminder {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  dueDate     DateTime?
  isActive    Boolean  @default(true)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}