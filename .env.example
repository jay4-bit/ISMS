# Required. Use Neon's pooled URL for app traffic and direct URL for migrations.
# Keep sslmode=require. Add connection_limit=10 and pool_timeout=10 to DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=10&pool_timeout=10
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Required secrets. Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=https://inventory.example.com

# Optional application settings
APP_PORT=3000
TRIAL_DAYS=3

# Optional admin login
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH_B64=

# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Inshop
SMTP_FROM_EMAIL=
