# Required secrets. Generate JWT_SECRET with: openssl rand -base64 48
POSTGRES_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-a-long-random-secret

# Optional database and application settings
POSTGRES_DB=isms
POSTGRES_USER=isms
APP_PORT=3000
TRIAL_DAYS=3

# Optional admin login
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH_B64=

# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Inshop
SMTP_FROM_EMAIL=
